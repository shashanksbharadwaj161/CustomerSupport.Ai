# Copy to .env. Never commit .env.
# Anthropic key: preferred path is the app's Settings page (stored encrypted in data/).
# This value is only a fallback used when no key is stored in the DB.
ANTHROPIC_API_KEY=
# Default spend cap in USD (the live value is stored in the DB and editable in Settings).
SPEND_CAP_USD=10
# Required to edit the key / spend cap in Settings. Also enables the login gate (M2) when set.
ADMIN_PASSWORD=
# Set false when exposed through a tunnel: key cannot be changed from the UI.
ALLOW_KEY_EDIT=true
# both (default) | smallwebrtc (local only) | websocket (tunnel only). The Live Call page picks WebRTC on localhost, WebSocket elsewhere.
TRANSPORT=both
# LLM models
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACK_MODEL=claude-sonnet-5-5
# Where model weights are downloaded
MODELS_DIR=./models
# Hugging Face token (only if a gated model needs it)
HF_TOKEN=
